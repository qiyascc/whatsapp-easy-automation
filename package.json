{
  "name": "whatsapp-easy-automation",
  "version": "2.0.0",
  "description": "Self-hosted WhatsApp automation with a visual workflow editor and email, WhatsApp, Telegram and webhook triggers.",
  "type": "module",
  "main": "src/main.js",
  "imports": {
    "#app": "./src/Application.js",
    "#config/*": "./src/config/*",
    "#core/*": "./src/core/*",
    "#db/*": "./src/db/*",
    "#engine/*": "./src/engine/*",
    "#ingest/*": "./src/ingest/*",
    "#nodes/*": "./src/nodes/*",
    "#server/*": "./src/server/*",
    "#services/*": "./src/services/*",
    "#triggers/*": "./src/triggers/*",
    "#whatsapp/*": "./src/whatsapp/*"
  },
  "license": "MIT",
  "author": "qiyascc",
  "homepage": "https://github.com/qiyascc/whatsapp-easy-automation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiyascc/whatsapp-easy-automation.git"
  },
  "keywords": [
    "whatsapp",
    "automation",
    "workflow",
    "baileys",
    "bot",
    "self-hosted"
  ],
  "scripts": {
    "start": "node start.js",
    "check": "node --check start.js && node scripts/verify.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^6.7.9",
    "express": "^4.21.2",
    "imapflow": "^1.0.164",
    "mailparser": "^3.7.1",
    "pino": "^9.4.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.3.0"
  }
}
